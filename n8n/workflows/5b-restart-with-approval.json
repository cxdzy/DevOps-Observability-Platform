{
  "name": "5b Restart with approval",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nstore.lastRestart = Date.now();\nconst pick = $('Pick incident').first().json;\nconst res = $input.first().json;\nconst result = res.data && res.data.result && res.data.result[0];\nconst up = result ? String(result.value[1]) === '1' : false;\nconst mode = pick.auto ? 'auto' : 'approved';\nconst how = pick.auto ? 'Automatic restart' : 'Approved restart';\nconst text = `${how} of sample-service (signal ${pick.signal}, ${pick.minutes} flagged minutes). ` +\n  (up ? 'Monitoring shows it is up again (checked 60 seconds after the restart).'\n      : 'Monitoring does not show it as up yet. Please check it.');\nreturn [{ json: { text, mode, signal: pick.signal, minutes: Math.round(Number(pick.minutes)), up: up ? 1 : 0, at: Date.now() - 60000 } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1632,
        -16
      ],
      "id": "1af8786f-a68c-4128-a477-787c9eea4e67",
      "name": "Build Result"
