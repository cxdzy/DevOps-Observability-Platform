      "name": "Every minute"
    },
    {
      "parameters": {
        "jsCode": "const AUTO = false;           // true: restart without asking once an incident has 2 flagged minutes. false: ask on Telegram first\nconst MIN_MINUTES_AUTO = 2;\nconst COOLDOWN_MS = 10 * 60 * 1000;\nconst store = $getWorkflowStaticData('global');\nconst res = $input.first().json;\nconst series = res.results && res.results[0] && res.results[0].series ? res.results[0].series[0] : null;\nconst rows = [];\nif (series) {\n  for (const v of series.values) {\n    const r = {};\n    series.columns.forEach((c, i) => { r[c] = v[i]; });\n    rows.push(r);\n  }\n}\nstore.handled = store.handled || {};\nif (!store.init) {\n  rows.forEach(r => { store.handled[r.time] = true; });\n  store.init = true;\n  return [];\n}\nconst now = Date.now();\nfor (const t of Object.keys(store.handled)) {\n  if (now - Number(t) > 12 * 3600 * 1000) delete store.handled[t];\n}\nfor (const r of rows) {\n  if (store.handled[r.time]) continue;\n  if (r.action !== 'restart') { store.handled[r.time] = true; continue; }\n  if (AUTO && Number(r.minutes) < MIN_MINUTES_AUTO) continue;\n  store.handled[r.time] = true;\n  if (store.lastRestart && now - store.lastRestart < COOLDOWN_MS) continue;\n  const dep = r.deployment ? '\\nRecent deployment: yes' : '';\n  return [{ json: { auto: AUTO, signal: r.signal, minutes: r.minutes, text:\n    `Medium incident on sample-service, signal ${r.signal}\\n` +\n    `Peak score ${Number(r.peak_score).toFixed(2)}, ${r.minutes} min so far${dep}\\n\\n` +\n    `Restart sample-service now?` } }];\n}\nreturn [];"
      },
