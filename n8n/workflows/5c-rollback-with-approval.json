    {
      "parameters": {
        "jsCode": "const COOLDOWN_MS = 30 * 60 * 1000;\nconst store = $getWorkflowStaticData('global');\nconst toRows = (res) => {\n  const series = res.results && res.results[0] && res.results[0].series ? res.results[0].series[0] : null;\n  const out = [];\n  if (series) {\n    for (const v of series.values) {\n      const r = {};\n      series.columns.forEach((c, i) => { r[c] = v[i]; });\n      out.push(r);\n    }\n  }\n  return out;\n};\nconst rows = toRows($('Query incident_open').first().json);\nconst deployments = toRows($input.first().json);\nstore.handled = store.handled || {};\nif (!store.init) {\n  rows.forEach(r => { store.handled[r.time] = true; });\n  store.init = true;\n  return [];\n}\nconst now = Date.now();\nfor (const t of Object.keys(store.handled)) {\n  if (now - Number(t) > 12 * 3600 * 1000) delete store.handled[t];\n}\nfor (const r of rows) {\n  if (store.handled[r.time]) continue;\n  if (r.action !== 'rollback') { store.handled[r.time] = true; continue; }\n  store.handled[r.time] = true;\n  const minutes = Math.round(Number(r.minutes));\n  const skip = (outcome) => [{ json: { proceed: false, mode: 'skipped', outcome, signal: r.signal, minutes } }];\n  if (store.lastRollback && now - store.lastRollback < COOLDOWN_MS) return skip('skipped_cooldown');\n  // The deployment that caused the incident: the latest one up to a minute after the incident\n  // started and at most 20 minutes before it.\n  let dep = null;\n  for (const x of deployments) {\n    if (x.time <= r.time + 60000 && x.time >= r.time - 20 * 60000) dep = x;\n  }\n  if (!dep) return skip('skipped_no_deployment');\n  if (dep.source !== 'ci') return skip('skipped_simulated');\n  if (!dep.previous_image) return skip('skipped_no_previous_image');\n  const sha = String(dep.commit_sha || '').slice(0, 7);\n  return [{ json: { proceed: true, pickedAt: now, signal: r.signal, minutes, image: dep.previous_image, sha, text:\n    `High incident on sample-service after deployment ${sha}, signal ${r.signal}\\n` +\n    `Peak score ${Number(r.peak_score).toFixed(2)}, ${minutes} min so far\\n\\n` +\n    `Roll back to ${dep.previous_image}?` } }];\n}\nreturn [];"
      },
