    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nstore.lastRollback = Date.now();\nconst pick = $('Pick incident').first().json;\nconst runs = $('Get rollback run').first().json;\nconst run = runs.workflow_runs && runs.workflow_runs[0];\nconst runOk = !!run && Date.parse(run.created_at) >= pick.pickedAt && run.status === 'completed' && run.conclusion === 'success';\nconst upRes = $input.first().json;\nconst result = upRes.data && upRes.data.result && upRes.data.result[0];\nconst up = result ? String(result.value[1]) === '1' : false;\nconst outcome = runOk && up ? 'success' : 'failed';\nconst text = `Rollback of sample-service to ${pick.image} (signal ${pick.signal}). ` +\n  (runOk ? 'The rollback pipeline run finished successfully. ' : 'The rollback pipeline run did not finish successfully, please check GitHub Actions. ') +\n  (up ? 'Monitoring shows the service up.' : 'Monitoring does not show the service as up yet.');\nreturn [{ json: { text, mode: 'approved', outcome, signal: pick.signal, minutes: pick.minutes, up: up ? 1 : 0, image: pick.image, at: Date.now() } }];"
      },
