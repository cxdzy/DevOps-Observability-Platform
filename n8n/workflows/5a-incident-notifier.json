              "name": "q",
              "value": "SELECT\n\"tier\",\"action\",\"signal\",\"peak_score\",\"minutes\",\"source\",\"deployment\",\"explanation\" FROM \"incident_explanation\" WHERE time > now() - 3h ORDER BY time ASC"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
