
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_now
POSTGRES_USER=fyp_admin
POSTGRES_PASSWORD=change_me_now
POSTGRES_DB=fyp_observability
CLOUDFLARE_TUNNEL_TOKEN=
GRAFANA_HOSTNAME=grafana.cxdzy.dev
N8N_ENCRYPTION_KEY=
# Tailscale IP of the server (tailscale ip -4); n8n is published on it for approval links
N8N_TS_IP=
# Dashboard login. The database password goes into a URL, so use letters and digits only,
# for example the output of: openssl rand -hex 24
DASHBOARD_DB_PASSWORD=
# Google sign-in is off while GOOGLE_CLIENT_ID is empty
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Address the browser uses, for example http://localhost:3100 (default when empty)
APP_ORIGIN=
# true (default) or false; false only for local tests over plain http on a non-localhost address
COOKIE_SECURE=
# Containers whose CF-Connecting-IP header is believed, comma separated (default cloudflared; none = nobody)
TRUSTED_PROXY_HOSTS=
# Absolute session limit in hours, however active the user is (default 24)
SESSION_MAX_AGE_HOURS=
